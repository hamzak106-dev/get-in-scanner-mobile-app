DECLARE
    v_response TEXT;
    v_attempts INTEGER := 0;
    v_max_attempts CONSTANT INTEGER := 3;
    v_success BOOLEAN := FALSE;
BEGIN
    -- Only proceed if status has changed
    IF (OLD.status IS DISTINCT FROM NEW.status) THEN
        -- Retry loop
        WHILE v_attempts < v_max_attempts AND NOT v_success LOOP
            BEGIN
                v_attempts := v_attempts + 1;

                -- Attempt to make the HTTP request with headers
                SELECT content INTO v_response FROM http_post(
            'https://api.getin-nextgen.com/api/scanner-app/attendees?scanner-api-key=5c578ce23c24d16ea1d95b2fd248b3a6',
            to_json(
                json_build_object(
                    'type', TG_OP,
                    'table', 'attendee',
                    'record', json_build_object(
                        'id', NEW.id,
                        'name', NEW.name,
                        'email', NEW.email,
                        'ticket_id', NEW.ticket_id,
                        'event_id', NEW.event_id,
                        'purchase_id', NEW.purchase_id,
                        'ticket_hash', NEW.ticket_hash,
                        'status', NEW.status,
                        'updated_at', CURRENT_TIMESTAMP
                    ),
                    'schema', 'public',
                    'old_record', json_build_object(
                        'id', OLD.id,
                        'name', OLD.name,
                        'email', OLD.email,
                        'ticket_id', OLD.ticket_id,
                        'event_id', OLD.event_id,
                        'purchase_id', OLD.purchase_id,
                        'ticket_hash', OLD.ticket_hash,
                        'status', OLD.status
                    )
                )
            )::text,
            'application/json'
        );

                -- If we get here, the request was successful
                v_success := TRUE;

                -- Log successful attempt
                INSERT INTO trigger_logs (
                    trigger_name,
                    table_name,
                    record_id,
                    old_status,
                    new_status,
                    http_response,
                    api_success
                )
                VALUES (
                    'attendee_status_webhook_trigger',
                    'attendee',
                    NEW.id,
                    OLD.status,
                    NEW.status,
                    v_response,
                    TRUE
                );

                RAISE NOTICE 'API call successful on attempt %', v_attempts;

            EXCEPTION WHEN OTHERS THEN
                -- Log failed attempt
                RAISE NOTICE 'API call failed on attempt %. Error: %', v_attempts, SQLERRM;

                -- If this was the last attempt, log the failure and update attendee status_update
                IF v_attempts = v_max_attempts THEN
                    INSERT INTO trigger_logs (
                        trigger_name,
                        table_name,
                        record_id,
                        old_status,
                        new_status,
                        http_response,
                        api_success
                    )
                    VALUES (
                        'attendee_status_webhook_trigger',
                        'attendee',
                        NEW.id,
                        OLD.status,
                        NEW.status,
                        'ERROR after ' || v_attempts || ' attempts. Last error: ' || SQLERRM,
                        FALSE
                    );

                    -- Update status_update field to false after all retries fail
                    UPDATE attendee
                    SET status_update = FALSE
                    WHERE id = NEW.id;
                END IF;

                -- Add a small delay before retry (0.5 seconds)
                PERFORM pg_sleep(0.5);
            END;
        END LOOP;
    END IF;

    RETURN NEW;
END;